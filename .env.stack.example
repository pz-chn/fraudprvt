MYSQL_ROOT_PASSWORD=
MYSQL_ACCOUNT=
MYSQL_PASSWORD=
MYSQL_DATABASE=
WORKER_ACCOUNT=
WORKER_PASSWORD=
API_DB_ACCOUNT=
API_DB_PASSWORD=
CRAWLER_DB_ACCOUNT=
CRAWLER_DB_PASSWORD=
# Airflow metadata DB 的帳號（需先在 MySQL 建立，並授權 airflow 資料庫）
AIRFLOW_DB_ACCOUNT=
# Airflow metadata DB 帳號的密碼
AIRFLOW_DB_PASSWORD=
# Airflow 網頁介面的 admin 帳號
AIRFLOW_ADMIN_USER=
# Airflow 網頁介面的 admin 密碼
AIRFLOW_ADMIN_PASSWORD=
# 加密 Airflow 連線與變數用的 Fernet key（用 cryptography 的 Fernet.generate_key() 產生）
AIRFLOW_FERNET_KEY=
# Airflow webserver 的 secret key，scheduler、worker、webserver 共用同一把
AIRFLOW_SECRET_KEY=
